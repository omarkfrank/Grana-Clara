# ============================================================
# GEMINI
# ============================================================

# Chave privada utilizada exclusivamente pelo backend.
#
# Nunca utilize prefixos como VITE_ nesta variável, pois isso
# poderia disponibilizar o valor no bundle do navegador.
GEMINI_API_KEY=

# Modelo utilizado tanto nos insights quanto no chat financeiro.
GEMINI_MODEL=gemini-3.6-flash


# ============================================================
# API INTERNA
# ============================================================

# Endereço em que a API escutará conexões.
#
# Desenvolvimento local:
# AI_API_HOST=127.0.0.1
#
# Alguns provedores de hospedagem exigem:
# AI_API_HOST=0.0.0.0
AI_API_HOST=127.0.0.1

# Porta utilizada pela API interna.
AI_API_PORT=8787

# Limite máximo do corpo de uma requisição, em bytes.
#
# 65536 bytes correspondem a 64 KB.
AI_MAX_BODY_SIZE_BYTES=65536


# ============================================================
# LIMITAÇÃO DE REQUISIÇÕES
# ============================================================

# Janela de tempo do limitador, em milissegundos.
AI_RATE_LIMIT_WINDOW_MS=60000

# Número máximo de solicitações à IA por endereço IP
# dentro da janela configurada.
AI_RATE_LIMIT_MAX_REQUESTS=20


# ============================================================
# PROXY DO VITE
# ============================================================

# Destino utilizado pelo Vite nos modos desenvolvimento e preview.
#
# Esta variável não utiliza o prefixo VITE_ e não é exposta
# ao código executado no navegador.
API_PROXY_TARGET=http://127.0.0.1:8787